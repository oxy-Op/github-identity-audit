# Optional: increases GitHub API limits and enables authenticated public surfaces.
# Use a fine-grained, read-only token and never commit the real value.
GITHUB_TOKEN=

# Optional OpenRouter adjudication.
OPENROUTER_API_KEY=

# Optional OpenAI-compatible embedding endpoint.
EMBEDDING_API_KEY=
EMBEDDING_ENDPOINT=
EMBEDDING_MODEL=

# Local services
NEXT_PUBLIC_AUDIT_API_URL=http://127.0.0.1:4318
AUDIT_WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
AUDIT_CONCURRENCY=1
AUDIT_DELETE_MIRRORS=true

# Hosted mode only
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=
